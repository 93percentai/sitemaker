{
  "name": "sitemaker",
  "version": "1.0.0",
  "description": "Static site generator for personal and org websites",
  "type": "module",
  "bin": {
    "sitemaker": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "build:css": "npx @tailwindcss/cli -i defaults/css/input.css -o defaults/css/tailwind.css --content 'defaults/templates/**/*.html'"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "highlight.js": "^11.11.0",
    "nunjucks": "^3.2.4",
    "toml": "^3.0.0",
    "chokidar": "^4.0.0",
    "fast-glob": "^3.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.0",
    "@types/nunjucks": "^3.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/cli": "^4.3.0"
  },
  "license": "MIT"
}
